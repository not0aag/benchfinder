{
  "name": "benchfinder",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:mobile": "pnpm --filter mobile start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "osm:import": "pnpm --filter @benchfinder/osm-import start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@benchfinder/config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
